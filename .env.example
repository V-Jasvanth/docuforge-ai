# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/docuforge?schema=public"

# Auth.js / NextAuth Configuration
AUTH_SECRET="your-super-secret-auth-key-at-least-32-chars-long"
NEXTAUTH_URL="http://localhost:3000"

# AI Provider Configuration (Independent Abstraction)
AI_PROVIDER="openai" # e.g., 'openai', 'anthropic', 'gemini'
AI_API_KEY="your_ai_provider_api_key_here"
AI_MODEL_NAME="gpt-4o"

# GitHub OAuth Integration (Server-Side Only)
GITHUB_CLIENT_ID="your_github_oauth_client_id"
GITHUB_CLIENT_SECRET="your_github_oauth_client_secret"

# Application Settings
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
